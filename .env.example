# Cloudflare Tunnel
CLOUDFLARED_TOKEN=

# Restic
RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/bucket-name/path
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backup paths
BACKUP_SOURCE=/srv/data
RESTIC_CACHE_DIR=/srv/data/restic-cache

# Voiceboard
VOICEBOARD_DATABASE_URL=database-url
VOICEBOARD_DEEPGRAM_API_KEY=deepgram-api-key
VOICEBOARD_GROQ_API_KEY=groq-api-key
VOICEBOARD_SUPABASE_URL=supabase-url

# Beszel
BESZEL_AGENT_TOKEN=

# n8n
N8N_POSTGRES_USER=changeUser
N8N_POSTGRES_PASSWORD=changePassword
N8N_POSTGRES_DB=n8n

N8N_POSTGRES_NON_ROOT_USER=changeUser
N8N_POSTGRES_NON_ROOT_PASSWORD=changePassword

N8N_RUNNERS_AUTH_TOKEN=changeRunnerAuthToken

N8N_SANDBOX_API_KEYS=change-me-api-key
N8N_SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-registration-token
N8N_SANDBOX_API_RUNNER_API_KEY=change-me-runner-key

# Must match a value in SANDBOX_API_KEYS above — this is how n8n authenticates to the sandbox
N8N_INSTANCE_AI_SANDBOX_API_KEY=change-me-api-key

N8N_SEARXNG_SECRET=change-me-searxng-secret
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

N8N_INSTANCE_AI_MODEL_API_KEY=openai-api-key

# Calnode
CALNODE_ENCRYPTION_KEY=
CALNODE_RECOVERY_SECRET=

# Hermes
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_SEARXNG_SECRET=

# 9Router
NINEROUTER_JWT_SECRET=
NINEROUTER_INITIAL_PASSWORD=
NINEROUTER_API_KEY_SECRET=
NINEROUTER_MACHINE_ID_SALT=
NINEROUTER_SEARXNG_SECRET=
